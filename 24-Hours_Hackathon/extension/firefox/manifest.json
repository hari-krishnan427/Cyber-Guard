{
  "manifest_version": 2,
  "name": "CyberGuard Protection",
  "version": "1.0",
  "description": "AI Powered Phishing Blocking System",

  "permissions": [
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "browser_action": {
    "default_title": "CyberGuard Protection"
  }
}